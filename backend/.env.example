# Comma-separated exact frontend origins; empty denies cross-origin browser access.
# Set the actual Vercel production HTTPS origin on Render.
# Local Vite proxy requests do not need CORS. Direct local calls can use:
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Render supplies PORT automatically. .env files are examples, not auto-loaded.
